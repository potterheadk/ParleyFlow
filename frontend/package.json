{
  "name": "parley-delivery-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "android:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "electron:build": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@supabase/supabase-js": "^2.43.4",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.7.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^6.0.3",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^0.20.1",
    "wait-on": "^9.0.10",
    "workbox-window": "^7.1.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.nachiket.parleyflow",
    "productName": "ParleyFlow",
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": "false",
      "allowToChangeInstallationDirectory": "true"
    }
  }
}
