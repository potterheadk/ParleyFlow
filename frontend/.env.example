# Frontend Environment Variables
# Copy this file to .env and fill in the values

# Supabase configuration (public/anon key - safe for frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key_here

# Optional: Backend API URL (for admin-only endpoints if using local FastAPI)

# Optional: Email domain for username -> email conversion
# If a user enters "admin" as username, it becomes "admin@father-parley.local"
VITE_LOGIN_EMAIL_DOMAIN=father-parley.local
